{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Explicit list, so @types packages are not picked up automatically —
    // react-syntax-highlighter ships its declarations (including the deep
    // `dist/esm/...` entry points) as ambient modules, which need naming here.
    "types": ["vite/client", "node", "react-syntax-highlighter"]
  },
  "include": ["src", "vite.config.ts"]
}
