# Copy to .env and fill in. .env is gitignored; .env.example is not.

# Port this backend listens on. The Vite dev server proxies /api here.
PORT=7020

# NB Wallet Connect.
#   local nb-wallet-connect dev server : http://localhost:5021
#   deployed                           : https://connect.nbwallet.org
WALLET_CONNECT_URL=https://connect.nbwallet.org

# The API key NB Wallet Connect issued for the Mortgage2Go hypotheekconsult
# service (default service id EH_A530D4346A7ACD00, see registration/).
# Never commit the real value.
WALLET_CONNECT_API_KEY=
